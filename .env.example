# ---- Backend API (server-side only) ----
COLLECTIVE_API_URL=https://collective-onc6.onrender.com/api/v1
# Older name, still read as a fallback:
# NEXT_PUBLIC_COLLECTIVE_API_URL=https://collective-onc6.onrender.com/api/v1
NEXT_PUBLIC_SITE_URL=https://nirmalranpariya.in

# ---- Dashboard (/me) ----
# Signs the dashboard session cookie. REQUIRED in production, random, 32+ characters:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The dashboard password itself is NOT set here — it lives in the backend as OWNER_PASSWORD_HASH.
AUTH_SECRET=

# Read-only Collective Ledger summary on the "System & tools" page (optional)
COLLECTIVE_ADMIN_EMAIL=
COLLECTIVE_ADMIN_PASSWORD=

# Lets the backend rate-limit each visitor separately (same value as INTERNAL_PROXY_SECRET on Render).
INTERNAL_PROXY_SECRET=

# ---- Gallery + birthday apps ----
BIRTHDAY_WISH_URL=https://birthday-wish-eight-pink.vercel.app
# Gallery app's Vercel address (it is shown to visitors at nirmalranpariya.in/LovedOnesGallery)
GALLERY_URL=https://dinky-n.vercel.app
# Same random value in this app, the gallery app and the birthday app → saves show up instantly
REVALIDATE_SECRET=

# ---- Optional ----
GITHUB_TOKEN=
GITHUB_USERNAME=NirmalTechDev

# Direct-email fallback so contact messages are never lost if the backend is asleep.
# Use a Gmail App Password, not your login password.
CONTACT_SMTP_HOST=smtp.gmail.com
CONTACT_SMTP_PORT=587
CONTACT_SMTP_USER=
CONTACT_SMTP_PASS=
# CONTACT_SMTP_FROM=
# CONTACT_TO=nirmaltech.dev@gmail.com
